  "title": "Cars24 Home",
  "version": 1,
  "components": [
    {
      "id": "banner_1",
      "type": "banner",
      "properties": {
        "imageUrl": "https://img.freepik.com/free-vector/modern-luxury-car-advertisement-banner_52683-102553.jpg",
        "title": "Buy Used Cars with Confidence",
        "subtitle": "Certified cars with warranty"
