        "items": [
          {"id": "hatchback", "label": "Hatchback", "icon": "hatchback_icon"},
          {"id": "sedan", "label": "Sedan", "icon": "sedan_icon"},
          {"id": "suv", "label": "SUV", "icon": "suv_icon"}
        ]
      }
    }
  ]
